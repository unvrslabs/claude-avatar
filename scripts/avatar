#!/bin/zsh
# Claude Code Avatar — desktop pet nativo (app Tauri), una finestra per sessione.
# Il server di stato gira come LaunchAgent com.unvrslabs.claude-avatar sulla porta 4848.
# Uso:  avatar          → apre una finestrella (agganciata alla sessione Claude attiva)
#       avatar quit     → chiude TUTTE le finestrelle

URL="http://127.0.0.1:4848"
APP="Claude Avatar"
BIN="claude-avatar"

if [[ "$1" == "quit" || "$1" == "chiudi" ]]; then
  pkill -x "$BIN" 2>/dev/null
  touch "$HOME/.claude-avatar-hidden"   # nasconde lo stato anche dalla status line
  echo "avatar chiuso"
  exit 0
fi

rm -f "$HOME/.claude-avatar-hidden"     # riapro → lo stato torna anche in status line

# se il server non risponde, avvia/riavvia il LaunchAgent
if ! curl -s -m 1 "$URL/state" >/dev/null 2>&1; then
  launchctl kickstart -k "gui/$(id -u)/com.unvrslabs.claude-avatar" 2>/dev/null \
    || launchctl load ~/Library/LaunchAgents/com.unvrslabs.claude-avatar.plist 2>/dev/null
  for i in {1..10}; do
    curl -s -m 1 "$URL/state" >/dev/null 2>&1 && break
    sleep 0.3
  done
fi

# -n: nuova istanza → ogni /avatar apre una finestra in piu', ognuna con la sua sessione
open -n -a "$APP" 2>/dev/null || {
  echo "avatar: app '$APP' non trovata in /Applications — fallback Chrome" >&2
  open -na "Google Chrome" --args --app="$URL" --window-size=230,230
}
echo "avatar aperto"
