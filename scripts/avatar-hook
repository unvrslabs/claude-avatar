#!/bin/zsh
# Hook Claude Code → server avatar (:4848), con sessione.
# Uso: avatar-hook <stato>   (stato speciale "bashresult" legge l'exit code, "bye" chiude la sessione)
# Riceve su stdin il JSON dell'evento hook: session_id, cwd, tool_response, ...

IN=$(cat 2>/dev/null)
SID=$(print -r -- "$IN" | jq -r '.session_id // ""' 2>/dev/null)
NAME=$(basename "$(print -r -- "$IN" | jq -r '.cwd // ""' 2>/dev/null)" 2>/dev/null)
NAME=${NAME//[^a-zA-Z0-9._-]/_}   # solo caratteri url-safe
ST="$1"

if [[ "$ST" == "bashresult" ]]; then
  ec=$(print -r -- "$IN" | jq -r '.tool_response.exit_code // 0' 2>/dev/null)
  if [[ "$ec" == "0" || "$ec" == "null" || -z "$ec" ]]; then ST=success; else ST=error; fi
fi

curl -s -m 1 "http://127.0.0.1:4848/set?state=${ST}&session=${SID}&cwd=${NAME}" >/dev/null 2>&1 || true
exit 0
