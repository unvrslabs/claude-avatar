{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Avatar",
  "version": "1.0.0",
  "identifier": "dev.unvrslabs.claude-avatar",
  "build": {
    "frontendDist": "http://127.0.0.1:4848"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Code Avatar",
        "width": 240,
        "height": 240,
        "minWidth": 160,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
